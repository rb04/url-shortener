# Copy to .env and adjust as needed. Do not commit .env.
#
# Postgres connection string.
#   - Docker Compose (recommended): port 5432, matches the default below
#   - Local Postgres already using 5432: point this at your actual port
DATABASE_URL=postgresql://user:password@localhost:5432/urlshortener

# Redis host (port is fixed at 6379 in main.py)
REDIS_HOST=localhost

# Base URL used to build the returned short links
BASE_URL=http://localhost:8000
